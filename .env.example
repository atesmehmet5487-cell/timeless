# Bulut (Firebase) yapılandırması.
#
# Bu dosyayı ".env" olarak kopyala ve Firebase panelindeki değerlerle doldur:
#   console.firebase.google.com → projen → ⚙ Project settings → General
#   → "Your apps" → Web uygulaması → SDK setup and configuration → Config
#
# Bu değişkenler girilmezse uygulama eskisi gibi yalnızca cihazda çalışır;
# giriş ekranı görünmez, bulut kodu devreye girmez.
#
# Not: Firebase'in web anahtarı gizli bir sır değildir (uygulamanın içine
# gömülür). Veriyi koruyan şey firebase/firestore.rules dosyasındaki
# kurallardır: giriş yapmayan kimse veriye erişemez.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# İsteğe bağlı
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
